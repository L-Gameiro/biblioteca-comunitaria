# Copie este arquivo para .streamlit/secrets.toml e preencha com suas
# credenciais reais do Supabase.
#
# NUNCA versione o secrets.toml real (ele já está listado no .gitignore).
# Veja o README.md para instruções de onde pegar essa connection string no
# painel do Supabase e como configurar o equivalente nos Secrets do
# Streamlit Community Cloud antes do deploy.

# Opção 1 — Conexão direta ao Postgres (porta 5432). Simples, mas cada
# sessão do Streamlit mantém uma conexão aberta; pode esgotar o limite de
# conexões do plano gratuito do Supabase se o app tiver muitos usuários.
# DATABASE_URL = "postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres"

# Opção 2 — Connection Pooler / PgBouncer em modo transaction (porta 6543).
# Recomendado para deploy no Streamlit Community Cloud.
DATABASE_URL = "postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:6543/postgres"
